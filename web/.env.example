# The development server forwards the REST calls here. The browser opens the WebSockets itself.
VITE_REALTIME_SPEECH_HTTP_URL=https://public.speech.tellus.ai.kr
VITE_REALTIME_SPEECH_WS_URL=wss://public.speech.tellus.ai.kr
# Issue a Sandbox (tl_test_) or Production (tl_live_) key in the Tellus API Console.
# Read by the development server only. It is not built into the browser bundle.
API_KEY=
VITE_TELLUS_AUDIO_SDK_ENABLED=true
# Artifact token API for the web engine and encrypted models.
TELLUS_AUDIO_DOWNLOAD_BASE_URL=https://public.speech.tellus.ai.kr
# Installation token from the Tellus API Console (Getting started → Issue audio engine token). Separate from API_KEY.
TELLUS_AUDIO_ENGINE_TOKEN=
VITE_TELLUS_AUDIO_ASSET_BASE=tellus-audio/
VITE_TELLUS_DENOISE=false
