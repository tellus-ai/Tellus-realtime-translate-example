{
  "name": "tellus-realtime-translation-web-example",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "predev": "npm run prepare:engine",
    "prebuild": "npm run prepare:engine",
    "preview": "vite preview",
    "test": "TMPDIR=/tmp vitest run",
    "test:live": "node --env-file=.env scripts/live-smoke.mjs",
    "typecheck": "tsc -b --pretty false",
    "prepare:engine": "node scripts/prepare-engine-assets.mjs",
    "test:engine-browser": "TMPDIR=/private/tmp node scripts/browser-engine-e2e.mjs"
  },
  "dependencies": {
    "@tellus-ai/audio-sdk": "file:../../tellus-audio-sdk",
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "playwright": "^1.58.2",
    "typescript": "latest",
    "vitest": "latest",
    "ws": "^8.21.3"
  }
}
