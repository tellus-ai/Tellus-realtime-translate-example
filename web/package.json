{
  "name": "tellus-realtime-translation-web-example",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "predev": "npm run prepare:vad",
    "prebuild": "npm run prepare:vad",
    "postinstall": "npm run sync:ort-assets",
    "prepare:vad": "npm run verify:vad-model && npm run sync:ort-assets",
    "sync:ort-assets": "node scripts/VADSyncOrtAssets.mjs",
    "verify:vad-model": "node scripts/VADVerifyModel.mjs",
    "preview": "vite preview",
    "test": "TMPDIR=/tmp vitest run",
    "test:live": "node --env-file=.env scripts/live-smoke.mjs",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "onnxruntime-web": "1.24.1",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest",
    "vitest": "latest",
    "ws": "^8.21.3"
  }
}
