{
  "name": "tellus-realtime-translation-desktop-example",
  "productName": "Tellus Realtime Translation",
  "version": "0.1.0",
  "description": "Electron example for Tellus realtime translation",
  "author": "Tellus",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "main": "dist/electron/main.js",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "tsc -p tsconfig.electron.json && node scripts/dev.mjs",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.electron.json && node scripts/write-runtime-env.mjs",
    "start": "electron .",
    "pack": "npm run build && electron-builder --dir --config.mac.identity=null",
    "dist": "npm run build && electron-builder",
    "test": "TMPDIR=/tmp vitest run",
    "test:live": "node --env-file=.env scripts/live-smoke.mjs",
    "test:engine-auth": "node --env-file=.env scripts/engine-authorization-smoke.mjs",
    "typecheck": "tsc -p tsconfig.json --pretty false && tsc -p tsconfig.electron.json --noEmit --pretty false"
  },
  "dependencies": {
    "@tellus-ai/audio-sdk": "git+https://github.com/tellus-ai/tellus-audio-sdk.git#v0.2.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "build": {
    "appId": "kr.ai.tellus.realtime-translation-example",
    "productName": "Tellus Realtime Translation",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*"
    ],
    "asarUnpack": [
      "node_modules/@tellus-ai/audio-sdk/vendor/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Microphone audio is streamed to Tellus for realtime transcription and translation."
      }
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
