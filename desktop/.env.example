# The npm run dev server forwards the REST calls here. The app opens the WebSockets itself.
REALTIME_SPEECH_HTTP_URL=https://public.speech.tellus.ai.kr
REALTIME_SPEECH_WS_URL=wss://public.speech.tellus.ai.kr
# Issue a Sandbox (tl_test_) or Production (tl_live_) key in the Tellus API Console.
# Read by the npm run dev server only. It is never given to the app or copied into a build.
API_KEY=
# For npm start and packaged apps, which have no dev server: your server with the same four
# /v1 routes that scripts/conversation-api-middleware.cjs provides. Copied into the build.
# TELLUS_EXAMPLE_API_URL=https://backend.example.com/__tellus/api
TELLUS_AUDIO_SDK_ENABLED=true
# Artifact token API for the native engine; the SDK package is installed from GitHub.
TELLUS_AUDIO_DOWNLOAD_BASE_URL=https://public.speech.tellus.ai.kr
# Installation token from the Tellus API Console (Getting started → Issue audio engine token). Separate from API_KEY.
TELLUS_AUDIO_ENGINE_TOKEN=
