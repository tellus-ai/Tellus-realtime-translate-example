# The audio SDK is a git dependency. npm prepares it in a temporary clone, where its installer
# cannot see this project's .env, so load TELLUS_AUDIO_ENGINE_TOKEN into the environment first.
# Same approach as Tellus-client-desktop. An exported TELLUS_AUDIO_ENGINE_TOKEN takes precedence.
node-options="--import=data:text/javascript,import%7BexistsSync%2CreadFileSync%7Dfrom'node%3Afs'%3Bimport%7Bjoin%7Dfrom'node%3Apath'%3Bimport%7BparseEnv%7Dfrom'node%3Autil'%3Bconst%20path%3Djoin(process.env.INIT_CWD%7C%7Cprocess.cwd()%2C'.env')%3Bif(existsSync(path)%26%26process.env.TELLUS_AUDIO_ENGINE_TOKEN%3D%3D%3Dundefined)%7Bconst%20token%3DparseEnv(readFileSync(path%2C'utf8')).TELLUS_AUDIO_ENGINE_TOKEN%3Bif(token!%3D%3Dundefined)process.env.TELLUS_AUDIO_ENGINE_TOKEN%3Dtoken%3B%7D"
