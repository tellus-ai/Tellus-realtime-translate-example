# 개발 서버(scripts/dev-server.mjs)가 REST 호출을 이 주소로 전달한다. 앱은 WebSocket만 직접 연다.
REALTIME_SPEECH_HTTP_URL=https://public.speech.tellus.ai.kr
REALTIME_SPEECH_WS_URL=wss://public.speech.tellus.ai.kr
# 서버에서 허용한 앱 Origin으로 설정한다.
APP_ORIGIN=https://devapp.tellus.ai.kr
# Issue a Sandbox (tl_test_) or Production (tl_live_) key in the Tellus API Console.
# 개발 서버만 읽는다. 앱과 .dart-defines.json에는 들어가지 않는다.
API_KEY=
# 개발 서버가 대기하는 포트.
TELLUS_EXAMPLE_SERVER_PORT=8787
# 앱이 개발 서버에 접속할 때 쓰는 주소. 비워 두면 http://localhost:<포트>이며, 시뮬레이터, 에뮬레이터, adb reverse로 연결한 기기는 이 값으로 동작한다.
# Wi-Fi로 접속하는 실기기는 여기에 Mac의 IP(예: http://192.168.0.10:8787)를, TELLUS_EXAMPLE_API_CLIENTS에 그 기기의 IP를 적는다.
TELLUS_EXAMPLE_SERVER_URL=
# 개발 서버 없이 실행하는 빌드에서 쓸, 같은 네 경로를 제공하는 서버. 비워 두면 개발 서버를 쓴다.
TELLUS_EXAMPLE_API_URL=
# 개발 서버는 이 Mac(시뮬레이터, 에뮬레이터, adb reverse로 연결한 기기)의 호출만 받는다.
# Wi-Fi로 접속하는 실기기는 그 기기의 IP를 쉼표로 구분해 적는다. 거절한 주소는 개발 서버 터미널에 표시된다.
TELLUS_EXAMPLE_API_CLIENTS=
# true로 설정하면 denoise를 켠 상태로 시작한다.
TELLUS_DENOISE=false
# SDK 설치용 artifact token API. 앱 런타임 URL과 별도로 지정할 수 있다.
TELLUS_AUDIO_DOWNLOAD_BASE_URL=https://public.speech.tellus.ai.kr
# Tellus API 콘솔(시작하기 → 오디오 엔진 토큰 발급하기)에서 발급한 설치 토큰. 런타임 API_KEY와 별도이며 앱과 .dart-defines.json에는 들어가지 않는다.
TELLUS_AUDIO_ENGINE_TOKEN=
